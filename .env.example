# Variaveis usadas apenas pelo docker-compose (desenvolvimento local).
# Copie para .env na raiz do projeto. O .env NAO e versionado.

# Senha do root do MySQL local
MYSQL_ROOT_PASSWORD=devroot

# Nome do banco criado no primeiro boot
MYSQL_DATABASE=todolist

# Segredo para assinar os JWT. Gere um valor aleatorio:
#   openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-de-32-bytes
