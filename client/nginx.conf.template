server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Corpo de requisicao pequeno: a API so recebe JSON curto.
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Chamadas da SPA para /api sao repassadas ao backend pela rede interna.
    # BACKEND_URL e substituido pelo entrypoint via envsubst.
    # A barra final em proxy_pass remove o prefixo /api antes de repassar:
    # /api/tasks no navegador vira /tasks no backend.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # Assets com hash no nome podem ser cacheados agressivamente.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Rotas do React Router: qualquer caminho desconhecido devolve o index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
