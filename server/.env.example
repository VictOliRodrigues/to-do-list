# Copie este arquivo para .env e preencha com valores reais.
# O .env NAO e versionado - nunca commite credenciais.

# Conexao com o MySQL
DATABASE_URL="mysql://usuario:senha@localhost:3306/todolist"

# Segredo para assinar os JWT. Gere um valor aleatorio, por exemplo:
#   openssl rand -hex 32
JWT_SECRET="troque-por-uma-string-aleatoria-de-32-bytes"

# Validade do token emitido no login
JWT_EXPIRES_IN="7d"

# Porta HTTP da API
PORT=3000

# development | production
NODE_ENV=development
